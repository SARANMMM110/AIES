# =============================================================================
# AI Enterprise Studio — Environment Variables
# Copy to .env and fill in values. Never commit .env or real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=AI Enterprise Studio
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_enterprise_studio?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_enterprise_studio?schema=public

# --- Authentication ---
# Use a long random string in production (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Payments ---
# simulated = complete + provision immediately (dev / smoke tests)
# stripe = Checkout Session + verified webhooks (production)
PAYMENT_PROVIDER=simulated
# Set true only for controlled production demos — never for live commerce
PAYMENT_ALLOW_SIMULATED=false
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (foundation) ---
# none = do not send; console = log rendered emails (dev only)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@aienterprisestudio.com
AES_INQUIRY_NOTIFY_EMAIL=m3emp110@gmail.com

# --- AI (optional) ---
# none = manual / retrieval-only paths; openai = OpenAI-compatible API
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_MIN=20

# --- Rate limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PURCHASE_MAX=20
RATE_LIMIT_AI_MAX=20

# --- Seed (optional, development only — never use these in production) ---
SEED_ADMIN_EMAIL=admin@aies.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@aies.local
SEED_USER_PASSWORD=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=AI Enterprise Studio
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYMENT_PROVIDER=simulated
