# Copy to .env.production on the VPS, then also:
#   cp .env.production .env
# (Docker Compose reads `.env` for ${VAR} substitution.)

NODE_ENV=production
APP_NAME=AI Enterprise Studio
APP_URL=https://aienterprisestudio.com
API_URL=https://aienterprisestudio.com
API_PORT=4000
CORS_ORIGIN=https://aienterprisestudio.com,https://www.aienterprisestudio.com

# --- Supabase Postgres (recommended for production) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
POSTGRES_DB=postgres
# Direct connection + SSL (required for migrate + API)
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public&sslmode=require

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

PAYMENT_PROVIDER=simulated
PAYMENT_ALLOW_SIMULATED=true
PAYMENT_CURRENCY=usd

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@aienterprisestudio.com
AES_INQUIRY_NOTIFY_EMAIL=m3emp110@gmail.com

AI_PROVIDER=none

# Same domain — browser calls https://aienterprisestudio.com/api/...
NEXT_PUBLIC_API_URL=https://aienterprisestudio.com
NEXT_PUBLIC_APP_NAME=AI Enterprise Studio
NEXT_PUBLIC_PAYMENT_PROVIDER=simulated

SEED_ADMIN_EMAIL=admin@aienterprisestudio.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
