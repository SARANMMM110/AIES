# Copy to .env.production on the VPS (never commit real secrets).
NODE_ENV=production
APP_NAME=AI Enterprise Studio
APP_URL=https://aienterprisestudio.com
API_URL=https://api.aienterprisestudio.com
API_PORT=4000
CORS_ORIGIN=https://aienterprisestudio.com,https://www.aienterprisestudio.com

POSTGRES_USER=aes
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ai_enterprise_studio
DATABASE_URL=postgresql://aes:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/ai_enterprise_studio?schema=public

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

PAYMENT_PROVIDER=simulated
PAYMENT_ALLOW_SIMULATED=true
PAYMENT_CURRENCY=usd

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@aienterprisestudio.com
AES_INQUIRY_NOTIFY_EMAIL=m3emp110@gmail.com

AI_PROVIDER=none

NEXT_PUBLIC_API_URL=https://api.aienterprisestudio.com
NEXT_PUBLIC_APP_NAME=AI Enterprise Studio
NEXT_PUBLIC_PAYMENT_PROVIDER=simulated

# Optional first seed (run manually after first migrate if needed)
SEED_ADMIN_EMAIL=admin@aienterprisestudio.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
